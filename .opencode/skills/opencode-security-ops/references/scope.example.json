      "methods": ["GET", "HEAD"]
    }
  ],
  "deny": [
    {
      "host": "admin.sandbox.example.com",
      "schemes": ["https"],
      "ports": [443],
      "path_prefixes": ["/"],
      "methods": ["GET", "HEAD", "OPTIONS"]
    }
  ],
  "limits": {
    "requests_per_second": 1,
    "max_concurrency": 1
  }
}
